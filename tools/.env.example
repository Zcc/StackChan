# Copy this file to tools/.env.local and fill in your private values.
# Keep tools/.env.local out of Git.

# Public relay websocket endpoint used by StackChan and the home bridge.
# Examples:
#   ws://example.com:8787/ws
#   wss://relay.example.com/ws
RELAY_URL=wss://relay.example.com/ws

# Shared relay token. Never commit the real value.
RELAY_TOKEN=replace-me

# StackChan device id. Usually the factory MAC without separators.
# Example: AABBCCDDEEFF
DEVICE_ID=AABBCCDDEEFF

# Optional local token for the bridge HTTP API on your home computer.
BRIDGE_TOKEN=local-agent-token
